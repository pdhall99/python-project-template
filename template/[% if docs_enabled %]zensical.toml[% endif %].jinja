[% macro toml_escape(value) %][[[ value | replace('\\', '\\\\') | replace('"', '\\"') ]]][% endmacro -%]
[project]
site_url = "https://[[[ github_owner ]]].github.io/[[[ project_name ]]]"
site_name = "[[[ project_name ]]]"
site_description = "[[[ toml_escape(project_description) ]]]"
site_author = "[[[ toml_escape(author_name) ]]]"
copyright = "Copyright &copy; [[[ copyright_year ]]] [[[ toml_escape(author_name) ]]]"

repo_url = "https://github.com/[[[ github_owner ]]]/[[[ project_name ]]]"
repo_name = "[[[ github_owner ]]]/[[[ project_name ]]]"
edit_uri = "edit/main/docs/site"

docs_dir = "docs/site"

nav = [
  { "Home" = "index.md" },

  { "Getting started" = [
    "getting-started/index.md",
    "getting-started/installation.md",
  ] },

  { "API reference" = [
    "api/index.md",
  ] },

  { "Project" = [
    "project/index.md",
    "project/changelog.md",
    "project/compatibility-and-versioning.md",
    "project/contributing.md",
    "project/license.md",
  ] },
]

[% raw %][[project.extra.social]][% endraw %]
icon = "fontawesome/brands/github"
link = "https://github.com/[[[ github_owner ]]]"
name = "[[[ toml_escape(author_name) ]]] on GitHub"

[project.theme]
language = "en"
features = [
  "announce.dismiss",
  "content.code.annotate",
  "content.code.copy",
  "content.code.select",
  "content.footnote.tooltips",
  "content.tabs.link",
  "content.tooltips",
  "navigation.footer",
  "navigation.indexes",
  "navigation.instant",
  "navigation.instant.prefetch",
  "navigation.path",
  "navigation.sections",
  "navigation.top",
  "navigation.tracking",
  "search.highlight",
]

[% raw %][[project.theme.palette]][% endraw %]
media = "(prefers-color-scheme)"
toggle.icon = "lucide/sun-moon"
toggle.name = "Switch to light mode"

[% raw %][[project.theme.palette]][% endraw %]
media = "(prefers-color-scheme: light)"
scheme = "default"
toggle.icon = "lucide/sun"
toggle.name = "Switch to dark mode"

[% raw %][[project.theme.palette]][% endraw %]
media = "(prefers-color-scheme: dark)"
scheme = "slate"
toggle.icon = "lucide/moon"
toggle.name = "Switch to system preference"

[project.markdown_extensions]
abbr = {}
admonition = {}
attr_list = {}
def_list = {}
footnotes = {}
md_in_html = {}
toc.permalink = true
pymdownx.betterem = {}
pymdownx.caret = {}
pymdownx.details = {}
pymdownx.emoji.emoji_generator = "zensical.extensions.emoji.to_svg"
pymdownx.emoji.emoji_index = "zensical.extensions.emoji.twemoji"
pymdownx.highlight.anchor_linenums = true
pymdownx.highlight.line_spans = "__span"
pymdownx.highlight.pygments_lang_class = true
pymdownx.inlinehilite = {}
pymdownx.keys = {}
pymdownx.magiclink = {}
pymdownx.mark = {}
pymdownx.smartsymbols = {}
pymdownx.snippets.base_path = ["."]
pymdownx.snippets.check_paths = true
pymdownx.superfences.custom_fences = [
  { name = "mermaid", class = "mermaid", format = "pymdownx.superfences.fence_code_format" },
]
pymdownx.tabbed.alternate_style = true
pymdownx.tabbed.combine_header_slug = true
pymdownx.tasklist.custom_checkbox = true
pymdownx.tilde = {}

[project.plugins.mkdocstrings.handlers.python]
inventories = ["https://docs.python.org/3/objects.inv"]
paths = ["src"]

[project.plugins.mkdocstrings.handlers.python.options]
docstring_style = "google"
filters = ["!^_"]
inherited_members = true
show_source = false
show_signature = true
show_signature_annotations = true
separate_signature = true
signature_crossrefs = true
annotations_path = "brief"
